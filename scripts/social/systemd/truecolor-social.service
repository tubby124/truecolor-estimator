[Unit]
Description=Bounded True Color six-destination social pilot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=truecolor-social
UMask=0077
LoadCredential=cron-secret:/etc/truecolor-social/cron-secret
LoadCredential=telegram-bot-token:/etc/truecolor-social/telegram-bot-token
LoadCredential=telegram-chat-id:/etc/truecolor-social/telegram-chat-id
ExecStart=/usr/bin/python3 /opt/truecolor-social/vps-scheduler.py --run
TimeoutStartSec=900
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/opt/truecolor-social /etc/truecolor-social
